{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["NODE_AUTH_TOKEN"],
  "globalDependencies": [
    "turbo.json",
    "yarn.lock",
    "stylelint.config.cjs",
    "knip.ts",
    "Dockerfile",
    ".prettierrc",
    "packages/config/eslint/eslint.config.mjs",
    "packages/config/typescript/tsconfig.json",
    "packages/config/vite/vite.config.mjs",
    "packages/config/vite/vitest-setup.ts",
    ".storybook/**",
    "@types/**"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "generate": {
      "cache": false
    },
    "generate:local": {
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "tsc": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "eslint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "eslint:fix": {
      "outputs": []
    },
    "stylelint": {
      "outputs": []
    },
    "prettier:fix": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "build:storybook": {
      "outputs": [".storybook-static-build/**"]
    },
    "build": {
      "dependsOn": ["^build", "tsc"],
      "outputs": ["dist"]
    },
    "clean": {
      "cache": false
    }
  }
}
