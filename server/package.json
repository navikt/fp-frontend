{
  "name": "@fp-frontend/server",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "eslint": "eslint src/**/*.ts* --color",
    "eslint:fix": "eslint --fix src/**/*.ts* --color",
    "prettier": "prettier --check src",
    "prettier:fix": "prettier --write src"
  },
  "dependencies": {
    "@navikt/oasis": "4.2.2",
    "@navikt/vite-mode": "1.0.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "http-proxy-middleware": "4.2.1",
    "morgan": "1.12.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "78.0.0",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
