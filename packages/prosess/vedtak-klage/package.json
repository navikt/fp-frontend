{
  "name": "@navikt/fp-prosess-vedtak-klage",
  "license": "MIT",
  "description": "Prosesspanel for vedtak i klagesak, viser resultatet og lar saksbehandler arbeide med vedtaksbrev for avvisning, stadfestelse, omgjøring, oppheving eller hjemsending.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "build:storybook": "storybook build -o .storybook-static-build",
    "test": "vitest",
    "eslint": "eslint {src,i18n}/**/*.ts* --color",
    "eslint:fix": "eslint --fix {src,i18n}/**/*.ts* --color",
    "prettier:fix": "prettier --write src",
    "tsc": "tsc --noEmit",
    "clean": "rm -rf ./dist ./node_modules ./.turbo ./.storybook-static-build",
    "storybook": "storybook dev --quiet -p 7084"
  },
  "dependencies": {
    "@navikt/ds-react": "8.19.2",
    "@navikt/fp-kodeverk": "workspace:*",
    "@navikt/fp-prosess-felles": "workspace:*",
    "@navikt/fp-types": "workspace:*",
    "@navikt/fp-types-avklar-aksjonspunkter": "workspace:*",
    "@navikt/fp-utils": "workspace:*",
    "@navikt/ft-ui-komponenter": "9.0.2",
    "@navikt/ft-utils": "6.0.2",
    "dayjs": "1.11.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.4"
  },
  "devDependencies": {
    "@navikt/fp-config-eslint": "workspace:*",
    "@navikt/fp-config-typescript": "workspace:*",
    "@navikt/fp-config-vite": "workspace:*",
    "@navikt/fp-storybook-utils": "workspace:*",
    "@navikt/fp-utils-test": "workspace:*",
    "@storybook/react": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "eslint": "10.12.0",
    "storybook": "10.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
