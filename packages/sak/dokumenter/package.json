    "@navikt/fp-config-vite": "workspace:*",
    "@navikt/fp-utils-test": "workspace:*",
    "@storybook/react": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/dom": "10.4.2",
