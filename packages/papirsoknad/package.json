  "description": "Skjema for registrering av papirsøknader om foreldrepenger, svangerskapspenger og engangsstønad.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "build:storybook": "storybook build -o .storybook-static-build",
