    "@navikt/fp-types": "workspace:*",
    "@navikt/ft-form-hooks": "14.1.0",
    "@navikt/ft-form-validators": "8.0.0",
    "@navikt/ft-ui-komponenter": "10.0.0",
    "@navikt/ft-utils": "8.0.0",
    "dayjs": "1.11.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-intl": "12.1.6",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@navikt/fp-config-eslint": "workspace:*",
