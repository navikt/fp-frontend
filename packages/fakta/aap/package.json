  "description": "Faktapanel for arbeidsavklaringspenger kombinert med arbeid eller frilans, lar saksbehandler kontrollere om beregningen er korrekt eller må overstyres.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
